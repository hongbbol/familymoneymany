# Postgres 연결 문자열 (Neon 대시보드 → Connect 에서 복사)
# Vercel에서 Neon을 연결하면 이 두 값은 자동으로 들어갑니다.
# 로컬 개발엔 Neon에서 dev 브랜치를 하나 만들어 쓰거나, 로컬 Postgres 주소를 넣으세요.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 로그인 비밀번호 (혼자 쓰는 앱이라 하나만)
APP_PASSWORD="change-me"

# 로그인 쿠키 서명용 비밀값 — `openssl rand -base64 32` 로 생성
AUTH_SECRET="change-me-use-openssl-rand-base64-32"

# MacroDroid가 /api/ingest 호출 시 함께 보내는 토큰 — `openssl rand -hex 24` 로 생성
INGEST_SECRET="change-me-random-string"
